# emulatorSHARE — copy to .env and fill in. NEVER commit the real .env.

# Port the relay listens on (public-facing via nginx/proxy).
EMULATOR_PORT=8090

# Secret that signs viewer session tokens. Generate with: openssl rand -hex 32
EMULATOR_JWT_SECRET=generate-with-openssl-rand-hex-32

# Token that headless-Chromium HOST processes must present to connect.
# Generate with: openssl rand -hex 32
EMULATOR_HOST_TOKEN=generate-with-openssl-rand-hex-32

# Set to 1 to allow unauthenticated viewers (LAN dev only, never production).
EMULATOR_ALLOW_GUEST=0

# SQLite database path.
EMULATOR_DB=/app/data/emulatorshare.db

# Which consoles to launch automatically at boot (comma-separated console keys).
EMULATOR_CONSOLE_KEYS=demo

# Log verbosity: verbose | info (default) | warn | error
EMULATOR_LOG=info

# Admin panel at /moderator — this username is the implicit OWNER (always has
# access). Additional admins are added from the panel itself (stored in the DB).
RELAY_OWNER=your-username

# Dedicated key-press log (who pressed what, on which console). Default: keylog.log
# EMULATOR_KEYLOG_FILE=keylog.log

# Set to 1 to always trust CF-Connecting-IP / X-Forwarded-For headers when
# resolving client IPs. Only needed if your proxy is NOT on loopback/private
# network (e.g. an external nginx). The Cloudflare tunnel is auto-detected.
# EMULATOR_TRUST_PROXY=0

# Discord Activity auto-signup. Set these to your Discord Application's
# public client id / secret (https://discord.com/developers/applications).
# The secret is exchanged by THIS server only — never put it in client code.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI registered for the app. Must match the app's OAuth2 registered
# URL exactly (server-side only, never set by the client).
DISCORD_REDIRECT_URI=https://emushare.alkonsafe.dpdns.org/
